{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "prepare": "husky",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "pnpm -r --filter \"./artifacts/**\" --if-present run lint",
    "lint:fix": "pnpm -r --filter \"./artifacts/**\" --if-present run lint:fix"
  },
  "lint-staged": {
    "artifacts/adala/src/**/*.{ts,tsx}": [
      "pnpm --filter @workspace/adala exec eslint --fix --max-warnings=0"
    ],
    "artifacts/api-server/src/**/*.ts": [
      "pnpm --filter @workspace/api-server exec eslint --fix --max-warnings=0"
    ]
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "esbuild>@esbuild/darwin-arm64": "-",
      "esbuild>@esbuild/darwin-x64": "-",
      "esbuild>@esbuild/freebsd-arm64": "-",
      "esbuild>@esbuild/freebsd-x64": "-",
      "esbuild>@esbuild/linux-arm": "-",
      "esbuild>@esbuild/linux-arm64": "-",
