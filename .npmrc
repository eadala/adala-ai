auto-install-peers=false
strict-peer-dependencies=false
public-hoist-pattern[]=@aws-sdk/*
# pnpm ≥10 refuses `pnpm deploy` unless workspace packages are injected.
# Keep legacy deploy so Docker/Coolify `pnpm --filter @workspace/api-server deploy --prod`
# works on both pnpm 9.15.9 (pinned in Dockerfiles) and pnpm 10+ builders.
force-legacy-deploy=true
